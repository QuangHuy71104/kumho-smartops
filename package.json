{
  "name": "ksops-transport-control-demo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "db:check": "node --test tests/database-schema.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "db:seed:relational": "node --experimental-transform-types scripts/seed-relational-data.mjs",
    "db:seed:work-center": "node scripts/seed-work-center.mjs",
    "db:setup:supabase": "node --experimental-transform-types scripts/setup-supabase.mjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration:postgres": "node --experimental-transform-types --test tests/postgres-cargo.integration.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.27.0",
    "@vercel/functions": "3.9.5",
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "uuid": "14.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0"
  },
  "packageManager": "npm@11.1.0",
  "type": "module"
}
